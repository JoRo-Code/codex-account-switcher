    try:
        sys.exit(main())
    except (Error, OSError, ValueError) as exc:
        print('codex-accounts: ' + str(exc), file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print('\nCancelled.', file=sys.stderr)
        sys.exit(130)
