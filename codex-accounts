#!/usr/bin/env python3
"""Local ChatGPT account selection for Codex CLI. Python 3.9+, macOS/Linux."""
import argparse
import contextlib
import datetime as dt
import fcntl
import json
import io
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid

VERSION = '0.4.3'
ROOT = Path(os.environ.get('CODEX_ACCOUNTS_HOME', str(Path.home() / '.local/share/codex-accounts'))).expanduser().resolve()
BINARY = os.environ.get('CODEX_ACCOUNTS_BINARY', 'codex')
NAME = re.compile(r'^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$')
# Ambient credentials must never override the selected ChatGPT account.
AUTH_ENV = ('OPENAI_API_KEY', 'CODEX_API_KEY', 'CODEX_ACCESS_TOKEN',
            'OPENAI_IDENTITY_TOKEN_FILE', 'OPENAI_IDENTITY_PROVIDER_ID',
            'OPENAI_BASE_URL', 'CHATGPT_BASE_URL', 'CODEX_REMOTE_TOKEN',
            'CODEX_THREAD_ID', 'CODEX_SESSION_ID', 'CODEX_APP_TOOLS_PIPE_PATH',
            'CODEX_INTERNAL_ORIGINATOR_OVERRIDE')

class Error(Exception):
    pass

def private_dir(path):
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)

def atomic_json(path, value):
    private_dir(path.parent)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(value, f, indent=2)
            f.write('\n')
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default

@contextlib.contextmanager
def lock(name, shared=False):
    private_dir(ROOT / 'locks')
    with (ROOT / 'locks' / (name + '.lock')).open('a') as f:
        try:
            fcntl.flock(f, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Error('This account or conversation is busy. Close its active launcher session and retry.')
        yield

def account_home(name):
    if not NAME.fullmatch(name):
        raise Error('Account names must be 1–40 letters, digits, underscores or hyphens.')
    return ROOT / 'accounts' / name

def accounts():
    base = ROOT / 'accounts'
    return sorted(p.name for p in base.iterdir() if p.is_dir() and NAME.fullmatch(p.name)) if base.exists() else []

def require_account(name):
    home = account_home(name)
    if name not in accounts():
        raise Error('Unknown account. Connect it with: codex-accounts add ' + name)
    return home

def environment(name):
    env = os.environ.copy()
    for key in AUTH_ENV:
        env.pop(key, None)
    env['CODEX_HOME'] = str(require_account(name))
    return env

def permission_args():
    mode = read_json(ROOT / 'permissions.json', {}).get('mode', 'default')
    if mode == 'yolo':
        return ['-c', 'approval_policy="never"', '-c', 'sandbox_mode="danger-full-access"']
    if mode != 'default':
        raise Error('Unknown shared permission mode. Use: codex-accounts permissions default|yolo')
    return []

def permissions(mode=None):
    if mode:
        with lock('permissions'):
            atomic_json(ROOT / 'permissions.json', {'mode': mode})
    current = read_json(ROOT / 'permissions.json', {}).get('mode', 'default')
    print('Shared launcher permissions: ' + current)
    if current == 'yolo':
        print('All launcher accounts: no approval prompts, unrestricted filesystem and network.')
    else:
        print('Use each account’s Codex configuration and project defaults.')
    if mode:
        print('Restart existing launcher sessions to apply. Desktop and other Codex processes are not changed.')

def model_args():
    settings = read_json(ROOT / 'defaults.json', {})
    result = []
    for key in ('model', 'model_reasoning_effort'):
        value = settings.get(key)
        if value is not None:
            if not isinstance(value, str) or not value.strip():
                raise Error('Invalid shared model defaults. Use codex-accounts defaults --clear.')
            result += ['-c', key + '=' + json.dumps(value)]
    return result

def defaults(model=None, effort=None, clear=False):
    with lock('defaults'):
        settings = {} if clear else read_json(ROOT / 'defaults.json', {})
        if model is not None:
            if not model.strip(): raise Error('Model cannot be empty.')
            settings['model'] = model
        if effort is not None: settings['model_reasoning_effort'] = effort
        if clear or model is not None or effort is not None:
            atomic_json(ROOT / 'defaults.json', settings)
    print('Shared launcher model defaults:')
    print(json.dumps(settings, indent=2) if settings else 'Use each account’s Codex configuration.')
    print('Applies to new launches across all accounts. --model and in-chat selections override defaults.')

def command(*args, include_permissions=True):
    if not shutil.which(BINARY):
        raise Error('Codex CLI was not found on PATH. Install Codex first.')
    return [BINARY, *args, '-c', 'cli_auth_credentials_store="file"',
            '-c', 'forced_login_method="chatgpt"', '-c', 'model_provider="openai"',
            *model_args(), *(permission_args() if include_permissions else [])]

def owners():
    return read_json(ROOT / 'owners.json', {})

def session_records(account=None):
    ownership = owners()
    result = []
    for name in ([account] if account else accounts()):
        home = require_account(name)
        for path in (home / 'sessions').rglob('*.jsonl'):
            try:
                with path.open() as f:
                    line = f.readline(1024 * 1024)
                meta = json.loads(line)
                if meta.get('type') != 'session_meta':
                    continue
                meta = meta['payload']
                sid = str(uuid.UUID(meta['id']))
                if ownership.get(sid, name) != name:
                    continue
                result.append(dict(id=sid, account=name, cwd=meta.get('cwd', ''),
                                   history_mode=meta.get('history_mode', 'legacy'),
                                   title=session_title(path),
                                   modified=path.stat().st_mtime, path=str(path)))
            except (OSError, ValueError, KeyError):
                continue
    return sorted(result, key=lambda row: row['modified'], reverse=True)

def session_title(path):
    # Read only the beginning; never scan megabytes of tool output for a title.
    with path.open() as f:
        for line in f.read(262144).splitlines():
            try:
                item = json.loads(line)
                payload = item.get('payload', {})
                if item.get('type') == 'event_msg' and payload.get('type') == 'user_message':
                    value = payload.get('message', '')
                    if isinstance(value, str) and value.strip() and not value.lstrip().startswith('<'):
                        return ' '.join(value.split())[:90]
            except ValueError:
                continue
    return '(untitled)'

def pick(rows, label, describe):
    if not rows:
        raise Error('No ' + label + ' found.')
    if not sys.stdin.isatty():
        raise Error('Specify a selection explicitly; the picker needs an interactive terminal.')
    for i, row in enumerate(rows, 1):
        print(f'{i:>3}. {describe(row)}')
    value = input('Choose number (Enter to cancel): ').strip()
    if not value:
        raise Error('Cancelled.')
    if not value.isdigit() or not 1 <= int(value) <= len(rows):
        raise Error('Invalid selection.')
    return rows[int(value) - 1]

def choose_account(name=None):
    if name:
        require_account(name)
        return name
    names = accounts()
    if not names:
        raise Error('Connect your first account: codex-accounts add personal')
    if len(names) == 1:
        return names[0]
    return pick(names, 'accounts', lambda n: n)

def describe_session(row):
    when = dt.datetime.fromtimestamp(row['modified']).strftime('%m-%d %H:%M')
    return f"{row['id']}  {row['account']:<12} {when}  {row['title']}\n     {row['cwd']}"

def choose_session(sid=None, account=None):
    rows = session_records(account)
    if not sid:
        return pick(rows, 'saved conversations', describe_session)
    matches = [r for r in rows if r['id'].startswith(sid)]
    if len(matches) != 1:
        raise Error('Session ID must uniquely match a saved conversation; use codex-accounts sessions.')
    return matches[0]

def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def active_runs():
    runs = []
    for path in (ROOT / 'runs').glob('*.json'):
        row = read_json(path)
        if row and alive(row['pid']):
            runs.append(row)
    return runs

def guard_idle(row):
    for run in active_runs():
        if run['account'] == row['account'] and (run['session'] == row['id'] or run['session'] is None):
            raise Error('The conversation may still be running. Close the source CLI first. '
                        'New sessions on this account must also be closed before moving history.')

def login(name, device=False, create=False):
    home = account_home(name)
    if create:
        if home.exists():
            raise Error('Account name already exists. Reconnect with: codex-accounts login ' + name)
        private_dir(home)
    else:
        require_account(name)
    with lock('account-' + name):
        print(f'Connecting {name}. Select its ChatGPT account in the browser.', flush=True)
        args = ['login'] + (['--device-auth'] if device else [])
        status = subprocess.call(command(*args), env=environment(name))
        if status:
            raise Error(f'Login did not finish (exit {status}). Retry: codex-accounts login {name}')
        if not (home / 'auth.json').is_file():
            raise Error('Codex did not save file-based credentials. Check managed authentication settings.')
        (home / 'auth.json').chmod(0o600)
        print(f'Connected. Start with: codex-accounts run {name}')

def run(name, row=None, prompt=None, cwd=None, model=None):
    home = require_account(name)
    if not (home / 'auth.json').is_file():
        raise Error('Account has no cached login. Run: codex-accounts login ' + name)
    working = Path(cwd or (row and row['cwd']) or os.getcwd()).expanduser().resolve()
    if not working.is_dir():
        raise Error('Project directory does not exist: ' + str(working))
    with contextlib.ExitStack() as stack:
        stack.enter_context(lock('account-' + name, shared=True))
        if row:
            stack.enter_context(lock('session-' + row['id']))
            if owners().get(row['id'], name) != name:
                raise Error('This conversation has moved. Run resume again to use its current account.')
        args = ['resume', row['id']] if row else []
        args += ['--no-daemon', '--cd', str(working)]
        if model:
            args += ['--model', model]
        cmd = command(*args)
        if prompt:
            cmd += ['--', prompt]
        private_dir(ROOT / 'runs')
        marker = ROOT / 'runs' / (str(uuid.uuid4()) + '.json')
        atomic_json(marker, dict(pid=os.getpid(), account=name, session=row['id'] if row else None,
                                 cwd=str(working), started=time.time(), mode='manual',
                                 phase='CLI open; turn state unknown', model=model,
                                 title=(row or {}).get('title') or prompt))
        print(f'Account: {name} · Project: {working}', flush=True)
        try:
            return subprocess.call(cmd, env=environment(name), cwd=working)
        finally:
            marker.unlink(missing_ok=True)

def move(row, target, already_locked=False):
    require_account(target)
    if row['account'] == target:
        raise Error('This conversation already uses that account.')
    if row['history_mode'] != 'legacy':
        raise Error('Moving paginated history is not supported; no files were changed.')
    if not (require_account(target) / 'auth.json').is_file():
        raise Error('Connect the destination first: codex-accounts login ' + target)
    with lock('account-' + row['account'], shared=True), lock('account-' + target, shared=True), \
            (contextlib.nullcontext() if already_locked else lock('session-' + row['id'])), lock('registry'):
        guard_idle(row)
        if owners().get(row['id'], row['account']) != row['account']:
            raise Error('Conversation changed accounts; retry with its current location.')
        source = Path(row['path'])
        existing = list((require_account(target) / 'sessions').rglob('*' + row['id'] + '.jsonl'))
        if len(existing) > 1:
            raise Error('Destination contains duplicate session histories; no files were changed.')
        dest = existing[0] if existing else require_account(target) / 'sessions' / 'imported' / source.name
        private_dir(dest.parent)
        # An existing destination can contain older history from an earlier move.
        # Keep a backup outside sessions before replacing it.
        if dest.exists():
            backup = ROOT / 'backups' / (str(uuid.uuid4()) + '.jsonl')
            private_dir(backup.parent)
            shutil.copy2(dest, backup)
        fd, temp = tempfile.mkstemp(dir=dest.parent)
        os.close(fd)
        try:
            before = source.stat()
            shutil.copyfile(source, temp)
            after = source.stat()
            if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
                raise Error('Source changed while copying. Close the source session and retry.')
            os.replace(temp, dest)
        finally:
            if os.path.exists(temp):
                os.unlink(temp)
        ownership = owners()
        ownership[row['id']] = target
        atomic_json(ROOT / 'owners.json', ownership)
    print(f"Moved {row['id']} from {row['account']} to {target}.")
    print('Original history retained. Continue with: codex-accounts resume ' + row['id'])

def menu():
    if not accounts():
        if not sys.stdin.isatty():
            raise Error('Connect your first account: codex-accounts add personal')
        login(input('Name your first account (e.g. personal): ').strip(), create=True)
        return 0
    action = pick(['Automatic account routing', 'Start a conversation', 'Resume a conversation', 'Move a conversation',
                   'Connect another account', 'Account status', 'List accounts'], 'actions', str)
    if action == 'Automatic account routing':
        return auto_run()
    elif action == 'Connect another account':
        login(input('Account name: ').strip(), create=True)
    elif action == 'Account status':
        return show_status(watch=True)
    elif action == 'Start a conversation':
        return run(choose_account())
    elif action == 'Resume a conversation':
        row = choose_session()
        return run(row['account'], row)
    elif action == 'Move a conversation':
        row = choose_session()
        move(row, choose_account())
    else:
        list_accounts()
    return 0

def account_snapshot(name, timeout=8, include_usage=False):
    """Ask Codex for cached identity, without refreshing or exposing credentials."""
    with lock('account-' + name, shared=True):
        backend = Backend(name)
        deadline = time.monotonic() + timeout
        def request(ident, method, params):
            backend.send(dict(id=ident, method=method, params=params))
            while time.monotonic() < deadline:
                while backend.messages:
                    message = backend.messages.popleft()
                    if message.get('id') == ident:
                        if 'error' in message:
                            raise Error('Account identity unavailable.')
                        return message.get('result', {})
                if select.select([backend.process.stdout], [], [], .1)[0]:
                    backend.read()
            raise Error('Account identity lookup timed out.')
        try:
            request(1, 'initialize', {'clientInfo': {'name': 'codex_accounts_identity', 'version': VERSION}})
            backend.send({'method': 'initialized'})
            account = request(2, 'account/read', {'refreshToken': False}).get('account')
            report = dict(identity=('—', '—', 'needs login'), usage=None, usage_error=None, checked_at=time.time())
            if not account:
                report['usage_error'] = 'No ChatGPT login'
                return report
            if account.get('type') != 'chatgpt':
                report['identity'] = ('—', '—', 'not a ChatGPT login')
                report['usage_error'] = 'No ChatGPT login'
                return report
            def clean(value):
                return ''.join(c for c in str(value or '—') if c.isprintable())
            report['identity'] = (clean(account.get('email')), clean(account.get('planType')), 'cached')
            if include_usage:
                try:
                    report['usage'] = request(3, 'account/rateLimits/read', {})
                    report['checked_at'] = time.time()
                except (Error, OSError, ValueError):
                    report['usage_error'] = 'Could not fetch live limits; check login or connection'
            return report
        finally:
            backend.close()

def account_identity(name, timeout=8):
    return account_snapshot(name, timeout=timeout)['identity']

def clean_text(value):
    return ''.join(c for c in str('—' if value is None or value == '' else value) if c.isprintable())

def duration(seconds):
    minutes = max(0, int(seconds)) // 60
    days, minutes = divmod(minutes, 1440)
    hours, minutes = divmod(minutes, 60)
    if days: return f'{days}d' + (f' {hours}h' if hours else '')
    if hours: return f'{hours}h' + (f' {minutes}m' if minutes else '')
    return f'{minutes}m'

def reset_text(timestamp):
    if not isinstance(timestamp, (int, float)):
        return 'reset unknown'
    local = dt.datetime.fromtimestamp(timestamp).astimezone().strftime('%a %H:%M %Z')
    if timestamp <= time.time():
        return f'reset time passed ({local}); refresh to check'
    return f'resets {local} (in {duration(timestamp - time.time())})'

def usage_lines(usage):
    if usage is None:
        return ['Limits unavailable']
    lines = []
    allowed = usage.get('ordinaryUsageAllowed')
    if allowed is False:
        lines.append('Included usage: blocked by backend')
    elif allowed is True:
        lines.append('Included usage: allowed by backend')
    buckets = usage.get('rateLimitsByLimitId') or {}
    if not buckets:
        fallback = usage.get('rateLimits')
        buckets = {(fallback or {}).get('limitId') or 'codex': fallback} if fallback else {}
    for key, bucket in buckets.items():
        if not isinstance(bucket, dict): continue
        label = clean_text(bucket.get('limitName') or key)
        for name in ('primary', 'secondary'):
            window = bucket.get(name)
            if not isinstance(window, dict): continue
            used = window.get('usedPercent')
            mins = window.get('windowDurationMins')
            window_label = duration(mins * 60) if isinstance(mins, (int, float)) else name
            if isinstance(used, (int, float)):
                left = max(0, min(100, 100 - used))
                blocks = int(left / 10)
                meter = '[' + '#' * blocks + '-' * (10-blocks) + ']'
                amount = f'{meter} {left:g}% left ({used:g}% used)'
            else:
                amount = 'usage unknown'
            lines.append(f'{label} · {window_label}: {amount} · {reset_text(window.get("resetsAt"))}')
        reason = bucket.get('rateLimitReachedType')
        if reason: lines.append(f'{label}: {clean_text(reason).replace("_", " ")}')
        if bucket.get('spendControlReached') is True:
            lines.append(f'{label}: spending limit reached')
        individual = bucket.get('individualLimit')
        if individual:
            remaining = individual.get('remainingPercent')
            lines.append(f'{label} · spending allowance: {remaining if remaining is not None else "unknown"}% left · '
                         + reset_text(individual.get('resetsAt')))
        credits = bucket.get('credits')
        if isinstance(credits, dict):
            balance = 'unlimited' if credits.get('unlimited') else clean_text(credits.get('balance'))
            lines.append(f'{label} · workspace credits: {balance} (may be shared across accounts)')
    resets = usage.get('rateLimitResetCredits')
    if isinstance(resets, dict) and resets.get('availableCount') is not None:
        lines.append(f'Earned resets available: {resets["availableCount"]}')
    return lines or ['Limits unavailable (backend returned no quota windows)']

def collect_status(account=None):
    names = [account] if account else accounts()
    if account: require_account(account)
    runs = active_runs()
    routing = read_json(ROOT / 'routing.json', {})
    def collect(name):
        report = dict(identity=('—', '—', 'needs login'), usage=None,
                      usage_error='No cached login', checked_at=time.time())
        if (require_account(name) / 'auth.json').is_file():
            try:
                report = account_snapshot(name, include_usage=True, timeout=12)
            except (Error, OSError, ValueError):
                report.update(identity=('—', '—', 'identity unavailable'),
                              usage_error='Could not read account; check login or connection')
        report.update(label=name, runs=[r for r in runs if r['account'] == name],
                      routing=routing.get(name, {}))
        return report
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=max(1, min(4, len(names)))) as pool:
        return list(pool.map(collect, names))

def render_status(reports):
    print('CODEX ACCOUNTS · ' + dt.datetime.now().astimezone().strftime('%Y-%m-%d %H:%M:%S %Z'))
    if not reports:
        print('No accounts. Connect one with: codex-accounts add codex1')
    for report in reports:
        email, plan, identity_status = report['identity']
        print(f'\n{report["label"]} · {clean_text(email)} · {clean_text(plan)}')
        print(f'  Identity: {clean_text(identity_status)} · {len(report["runs"])} launcher session(s) open')
        cooldown = report['routing'].get('retry_after', 0)
        if cooldown > time.time():
            print('  Routing cooldown: retry eligible in ' + duration(cooldown - time.time()))
        if report.get('usage_error'):
            print('  Limits unavailable: ' + clean_text(report['usage_error']))
        else:
            checked = dt.datetime.fromtimestamp(report['checked_at']).astimezone().strftime('%H:%M:%S %Z')
            print('  Limits checked ' + checked)
            for line in usage_lines(report.get('usage')): print('  ' + line)
        for run in report['runs']:
            sid = run.get('session') or 'starting / ID not tracked'
            phase = clean_text(run.get('phase') or 'CLI open; turn state unknown')
            mode = clean_text(run.get('mode') or 'legacy launcher')
            print(f'  > {phase} · {mode} · PID {run["pid"]}')
            print('    Project: ' + clean_text(run.get('cwd')))
            print('    Conversation: ' + clean_text(sid))
            if run.get('title'): print('    Title: ' + clean_text(run['title'])[:120])
            if run.get('model'): print('    Model: ' + clean_text(run['model']))
            if run.get('started'):
                print('    Open for ' + duration(time.time() - run['started']))
    print('\nLocations cover this launcher on this computer, not desktop or ordinary codex sessions.')
    print('Missing limits mean unknown, not zero usage. Identity is cached; limits are queried live.')

def show_status(account=None, watch=False, interval=30, as_json=False):
    if watch and (as_json or not sys.stdout.isatty()):
        raise Error('--watch requires an interactive terminal and cannot be combined with --json.')
    if interval < 10:
        raise Error('Refresh interval must be at least 10 seconds.')
    try:
        while True:
            reports = collect_status(account)
            if watch: print('\033[2J\033[H', end='')
            if as_json: print(json.dumps(reports, indent=2))
            else: render_status(reports)
            if not watch: return 0
            print(f'\nRefresh every {interval}s · Ctrl-C to close')
            time.sleep(interval)
    except KeyboardInterrupt:
        if watch:
            print('\nStatus view closed.')
            return 0
        raise


def list_accounts():
    runs = active_runs()
    names = accounts()
    if not names:
        print('No accounts. Connect one with: codex-accounts add personal')
        return
    from concurrent.futures import ThreadPoolExecutor
    def identify(name):
        if not (require_account(name) / 'auth.json').is_file():
            return ('—', '—', 'needs login')
        try:
            return account_identity(name)
        except (Error, OSError, ValueError):
            return ('—', '—', 'identity unavailable')
    with ThreadPoolExecutor(max_workers=min(4, len(names))) as pool:
        identities = dict(zip(names, pool.map(identify, names)))
    email_width = max(5, *(len(identity[0]) for identity in identities.values()))
    plan_width = max(4, *(len(identity[1]) for identity in identities.values()))
    print(f"{'LABEL':<20} {'EMAIL':<{email_width}}  {'PLAN':<{plan_width}}  {'STATUS':<22} RUNNING")
    for name in names:
        count = sum(r['account'] == name for r in runs)
        routing = read_json(ROOT / 'routing.json', {}).get(name, {})
        remaining = max(0, int(routing.get('retry_after', 0) - time.time()))
        cooldown = f' · retry eligible in {remaining // 60}m {remaining % 60}s' if remaining else ''
        email, plan, status = identities[name]
        print(f"{name:<20} {email:<{email_width}}  {plan:<{plan_width}}  {status:<22} {count}{cooldown}")
    print('Email and plan are from cached Codex identity; quota and token validity are not checked.')
    print('Live limits and session locations: codex-accounts status --watch')

